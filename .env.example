# Echoes of an Era - Environment Configuration

# Database (PostgreSQL + pgvector)
POSTGRES_USER=echoes
POSTGRES_PASSWORD=echoes_password
POSTGRES_DB=echoes_of_an_era
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://echoes:echoes_password@localhost:5432/echoes_of_an_era

# LLM Service (Docker Model Runner / Ollama API compatible)
# Uses local Docker Model Runner (docker model) on port 12434
OLLAMA_BASE_URL=http://localhost:12434
OLLAMA_MODEL=gemma3:1B-Q4_K_M
LLM_BASE_URL=http://localhost:12434
LLM_MODEL=gemma3:1B-Q4_K_M

# STT & Embedding Models
WHISPER_MODEL_SIZE=large-v3-turbo
EMBEDDING_MODEL_NAME=BAAI/bge-m3
DEVICE=cpu
EMBEDDING_LOCAL_ONLY=true

# Storage
UPLOAD_DIR=./uploads/audio
MAX_UPLOAD_SIZE_MB=100

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
